# Server configuration
PORT=4000
NODE_ENV=development

# Database and Cache
MONGODB_URI=mongodb://localhost:27017/arms?replicaSet=rs0
REDIS_URL=redis://localhost:6379

# Cryptography (32-byte key encoded in base64)
# You can generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY_BASE64=your-32-byte-base64-key-here

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=24h

# File Upload Settings
UPLOAD_MAX_MB=100
STORAGE_DRIVER=local

# Export Config
EXPORT_MAX_ROWS=50000
